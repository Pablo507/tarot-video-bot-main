# Copiá este archivo como .env
# cp .env.example .env

# ── Groq — misma key que tarotgratis.online ──────────────────
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Pexels — misma key que SocialAI ─────────────────────────
PEXELS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Google Cloud TTS ─────────────────────────────────────────
# Ruta al archivo JSON del Service Account
GOOGLE_APPLICATION_CREDENTIALS=tts_credentials.json

# Voz de Google Cloud TTS (opcional — este es el default)
# Voces disponibles en español:
#   es-US-Neural2-A   → femenina, acento neutro latinoamericano (default)
#   es-US-Neural2-B   → masculina, acento neutro latinoamericano
#   es-US-Journey-F   → femenina, más expresiva y natural
#   es-ES-Neural2-A   → femenina, castellano de España
#   es-ES-Neural2-B   → masculina, castellano de España
# Ver todas: https://cloud.google.com/text-to-speech/docs/voices
GOOGLE_TTS_VOICE=es-US-Neural2-A
